{
  "manifest_version": 3,
  "name": "YT Контрол",
  "short_name": "YT Контрол",
  "description": "Мобилният YouTube без Shorts и реклами: предложения, абонаменти без профил, история, скорост, надписи и още.",
  "version": "3.2.0",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "content_scripts": [
    {
      "js": ["yt-control.js"],
      "matches": ["https://m.youtube.com/*"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "host_permissions": ["https://m.youtube.com/*", "https://sponsor.ajay.app/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "images/icon-48.png",
      "96": "images/icon-96.png",
      "128": "images/icon-128.png"
    }
  }
}
